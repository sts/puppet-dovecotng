# Authentication for SQL users. Included from 10-auth.conf.
#
# <doc/wiki/AuthDatabase.SQL.txt>

passdb {
  driver = sql

  # Path for SQL configuration file, see example-config/dovecot-sql.conf.ext
  args = /etc/dovecot/dovecot-sql.conf.ext
}

# "prefetch" user database means that the passdb already provided the
# needed information and there's no need to do a separate userdb lookup.
# <doc/wiki/UserDatabase.Prefetch.txt>
userdb {
  driver = prefetch
}

<%- if @queries['user_query'] -%>
userdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}
<%- else -%>
# Without a user_query, all users share the vmail user and a home directory
# below vmail_path. <doc/wiki/UserDatabase.Static.txt>
userdb {
  driver = static
  args = uid=<%= scope['dovecotng::vmail_user'] %> gid=<%= scope['dovecotng::vmail_group'] %> home=<%= scope['dovecotng::vmail_path'] %>/%d/%n
}
<%- end -%>
